{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "harvest() 内部流程与分支",
    "output": "flow-harvest.html",
    "quality_profile": "standard",
    "subtitle": "领取手续费:提取 vs 复投两分支,末尾健康校验"
  },
  "lanes": [
    {
      "id": "main",
      "label": "主流程"
    },
    {
      "id": "calc",
      "label": "守卫 / 分支"
    },
    {
      "id": "exc",
      "label": "revert 分支",
      "variant": "exception"
    }
  ],
  "phases": [
    {
      "id": "guard",
      "label": "守卫收费",
      "fromCol": 0,
      "toCol": 2
    },
    {
      "id": "branch",
      "label": "模式分支",
      "fromCol": 3,
      "toCol": 4,
      "variant": "emphasis"
    },
    {
      "id": "check",
      "label": "健康校验",
      "fromCol": 5,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "entry",
    "owner",
    "collect",
    "mode",
    "compound",
    "health"
  ],
  "nodes": [
    {
      "id": "entry",
      "lane": "main",
      "col": 0,
      "type": "external",
      "label": "harvest(id, compound)",
      "sublabel": "持有人调用",
      "width": 190
    },
    {
      "id": "owner",
      "lane": "calc",
      "col": 1,
      "type": "security",
      "label": "是持有人?",
      "sublabel": "ownerOf[id]==caller",
      "width": 160
    },
    {
      "id": "collect",
      "lane": "main",
      "col": 2,
      "type": "backend",
      "label": "收费 + 抽成",
      "sublabel": "收 LP fee·协议抽 10%",
      "width": 180
    },
    {
      "id": "mode",
      "lane": "calc",
      "col": 3,
      "type": "backend",
      "label": "compound?",
      "sublabel": "false→提取 / true→复投",
      "width": 170,
      "tag": "两分支"
    },
    {
      "id": "withdraw",
      "lane": "calc",
      "col": 4,
      "type": "backend",
      "label": "提取给用户",
      "sublabel": "净手续费两腿转用户",
      "width": 180
    },
    {
      "id": "compound",
      "lane": "main",
      "col": 4,
      "type": "backend",
      "label": "复投回仓",
      "sublabel": "归并→zap→increase→退零头",
      "width": 190
    },
    {
      "id": "health",
      "lane": "main",
      "col": 5,
      "type": "backend",
      "label": "健康校验",
      "sublabel": "价×LLTV≥债务 才收尾",
      "width": 180
    },
    {
      "id": "revHolder",
      "lane": "exc",
      "col": 1,
      "type": "external",
      "label": "revert",
      "sublabel": "NotHolder",
      "width": 150
    },
    {
      "id": "revUnhealthy",
      "lane": "exc",
      "col": 5,
      "type": "external",
      "label": "revert",
      "sublabel": "UNHEALTHY_AFTER_HARVEST",
      "width": 210
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": "entry",
      "to": "owner",
      "label": "校验持有人",
      "variant": "emphasis"
    },
    {
      "id": "e2",
      "from": "owner",
      "to": "collect",
      "label": "是",
      "variant": "emphasis"
    },
    {
      "id": "e3",
      "from": "collect",
      "to": "mode",
      "variant": "emphasis"
    },
    {
      "id": "e4",
      "from": "mode",
      "to": "withdraw",
      "label": "提取",
      "variant": "default"
    },
    {
      "id": "e5",
      "from": "mode",
      "to": "compound",
      "label": "复投",
      "variant": "emphasis"
    },
    {
      "id": "e6",
      "from": "compound",
      "to": "health",
      "variant": "emphasis"
    },
    {
      "id": "e7",
      "from": "withdraw",
      "to": "health",
      "variant": "default"
    },
    {
      "id": "x1",
      "from": "owner",
      "to": "revHolder",
      "label": "否",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "x2",
      "from": "health",
      "to": "revUnhealthy",
      "label": "抽穿",
      "variant": "security",
      "role": "error"
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "守卫",
      "items": [
        "只有持有人能领(ownerOf 校验)",
        "无论提取还是复投,协议抽成先拿(harvestFeeBps 10%)"
      ]
    },
    {
      "dot": "amber",
      "title": "两分支",
      "items": [
        "compound=false:净手续费两腿直接转用户落袋",
        "compound=true:手续费归并→zap→增流动性利滚利",
        "复投分支末尾退零头(修复:曾漏退致滞留)"
      ]
    },
    {
      "dot": "emerald",
      "title": "领完必查健康",
      "items": [
        "领取/复投后校验 fairValue×LLTV≥债务",
        "防止把仓位抽穿到可清算 → UNHEALTHY_AFTER_HARVEST"
      ]
    }
  ]
}