  "cards": [
    { "dot": "rose", "title": "守卫(任一不过即 revert)", "items": ["调用者必须在清算白名单", "仓位必须真不健康(公允价×LLTV<债务)", "repay 封顶债务的 50%(closeFactor)", "扣押量取整不能为 0"] },
    { "dot": "amber", "title": "扣押计算", "items": ["seizeValue = repay×(1+8% bonus)", "seizeValue ≥ 仓位价值 → 扣全部;否则按比例", "posVal 用抗操纵公允价,防低估超扣"] },
    { "dot": "emerald", "title": "结算(F2 修复要点)", "items": ["keeper 净得封顶应得 bonus,不按实际卖出所得", "超出应得部分先多还借款人债务、再退还本人", "全平后残债>0 → emit BadDebt 供监控"] }
  ]
