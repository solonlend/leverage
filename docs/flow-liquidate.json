    { "id": "e5", "from": "settleCore", "to": "payout", "variant": "emphasis" },

    { "id": "x1", "from": "gKeeper", "to": "revNotLiq", "label": "否", "variant": "security", "role": "error" },
    { "id": "x2", "from": "gHealth", "to": "revHealthy", "label": "健康", "variant": "security", "role": "error" },
    { "id": "x3", "from": "seize", "to": "revZero", "label": "=0", "variant": "security", "role": "error" },
    { "id": "x4", "from": "payout", "to": "revSlip", "label": "不足", "variant": "security", "role": "error" }
